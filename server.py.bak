# ==========================================
# 0. 容器资源获取辅助函数 (已修订探针优先级)
# ==========================================
def get_container_cpu_count():
    """获取容器实际分配的 CPU 核心数 (优先读取 cgroup 限制，防止 affinity 穿透到宿主机)"""
    cgroup_cores = None
    try:
        # cgroups v2 限制读取
        if os.path.exists('/sys/fs/cgroup/cpu.max'):
            with open('/sys/fs/cgroup/cpu.max') as f:
                quota, period = f.read().strip().split()
                if quota != 'max':
                    cgroup_cores = math.ceil(int(quota) / int(period))
        # cgroups v1 限制读取
        elif os.path.exists('/sys/fs/cgroup/cpu/cpu.cfs_quota_us'):
            with open('/sys/fs/cgroup/cpu/cpu.cfs_quota_us') as f:
                quota = int(f.read().strip())
            with open('/sys/fs/cgroup/cpu/cpu.cfs_period_us') as f:
                period = int(f.read().strip())
            if quota > 0:
                cgroup_cores = math.ceil(quota / period)
    except Exception:
        pass
        
    # 获取进程亲和度核心数或宿主机总核心数作为对比上限
    affinity_cores = multiprocessing.cpu_count()
    try:
        affinity_cores = len(os.sched_getaffinity(0))
    except AttributeError:
        pass

    # 如果 cgroup 设定了配额，取配额和亲和核心数的最小值（防止云机共享带来的穿透误判）
    if cgroup_cores is not None:
        return min(cgroup_cores, affinity_cores)
    return affinity_cores

def get_container_available_memory():
    """获取容器实际可用的内存 (Bytes)"""
    host_mem = psutil.virtual_memory().available
    cgroup_limit = None
    cgroup_usage = 0

    try:
        # cgroups v2
        if os.path.exists('/sys/fs/cgroup/memory.max'):
            with open('/sys/fs/cgroup/memory.max') as f:
                val = f.read().strip()
                if val != 'max':
                    cgroup_limit = int(val)
            if os.path.exists('/sys/fs/cgroup/memory.current'):
                with open('/sys/fs/cgroup/memory.current') as f:
                    cgroup_usage = int(f.read().strip())
        
        # cgroups v1
        elif os.path.exists('/sys/fs/cgroup/memory/memory.limit_in_bytes'):
            with open('/sys/fs/cgroup/memory/memory.limit_in_bytes') as f:
                val = int(f.read().strip())
                if val < 9223372036854771712:
                    cgroup_limit = val
            if os.path.exists('/sys/fs/cgroup/memory/memory.usage_in_bytes'):
                with open('/sys/fs/cgroup/memory/memory.usage_in_bytes') as f:
                    cgroup_usage = int(f.read().strip())
                    
        if cgroup_limit is not None:
            return min(host_mem, cgroup_limit - cgroup_usage)
    except Exception:
        pass

    return host_mem


# ==========================================
# 1. 核心 Pipeline (原有逻辑保持原样)
# ==========================================
class LongAudioAlignPipeline:
    def __init__(self, config):
        self.config = config
        self.device = os.environ.get("DEVICE", config.get("device", "cpu"))
        self.dtype = torch.float32
        
        total_cores = get_container_cpu_count()
        cpu_ratio = config.get("cpu_ratio", 0.5)
        allocated_cores = max(1, int(total_cores * cpu_ratio))
        torch.set_num_threads(allocated_cores)
        print(f"[*] 系统总核心数: {total_cores}, 已分配计算核心数: {allocated_cores}")

        vad_repo = os.environ.get("VAD_REPO", "snakers4/silero-vad")
        vad_model_name = os.environ.get("VAD_MODEL_NAME", "silero_vad")
        asr_path = os.environ.get("ASR_MODEL_PATH", "Qwen/Qwen3-ASR-0.6B")
        fa_path = os.environ.get("FA_MODEL_PATH", "Qwen/Qwen3-ForcedAligner-0.6B")

        print(f"[*] 正在加载模型...\n    运行设备: {self.device}\n    VAD: {vad_model_name}\n    ASR: {asr_path}\n    FA:  {fa_path}")
        
        self.vad_model, self.vad_utils = torch.hub.load(
            repo_or_dir=vad_repo, 
            model=vad_model_name,
            verbose=False
        )
        self.get_speech_timestamps = self.vad_utils[0] 

        self.asr_model = Qwen3ASRModel.from_pretrained(
            asr_path,
            dtype=self.dtype,
            device_map=self.device,
        )

        self.fa_model = Qwen3ForcedAligner.from_pretrained(
            fa_path,
            dtype=self.dtype,
            device_map=self.device,
        )
        print("[*] 模型加载完成！")

    def _normalize_text(self, text):
        text_sim = zhconv.convert(text, 'zh-cn')
        text_clean = re.sub(r'[^\u4e00-\u9fa5a-zA-Z0-9]', '', text_sim)
        return text_clean

    def _build_index_map(self, original_text):
        norm_text = ""
        idx_map = []
        sim_text = zhconv.convert(original_text, 'zh-cn')
        for i, char in enumerate(sim_text):
            if re.match(r'[\u4e00-\u9fa5a-zA-Z0-9]', char):
                norm_text += char
                idx_map.append(i)
        return norm_text, idx_map

    def _group_vad_timestamps(self, timestamps, total_audio_duration):
        if not timestamps:
            return []

        max_sec = self.config["chunk_max_sec"]
        chunks = []
        current_chunk = []
        start_time = 0
        
        for ts in timestamps:
            if not current_chunk:
                current_chunk.append(ts)
                start_time = ts['start']
                continue
            
            potential_end_time = ts['end']
            duration = potential_end_time - start_time
            
            if duration > max_sec:
                chunks.append({'start': current_chunk[0]['start'], 'end': current_chunk[-1]['end']})
                current_chunk = [ts]
                start_time = ts['start']
            else:
                current_chunk.append(ts)
                
        if current_chunk:
            chunks.append({'start': current_chunk[0]['start'], 'end': current_chunk[-1]['end']})

        desired_pad = self.config.get("vad_padding_sec", 0.3)
        padded_chunks = []
        
        for i, chunk in enumerate(chunks):
            start = chunk['start']
            end = chunk['end']
            
            if i == 0:
                front_pad = min(start, desired_pad)
            else:
                gap = start - chunks[i-1]['end']
                front_pad = min(desired_pad, gap / 2.0)
                
            if i == len(chunks) - 1:
                back_pad = min(total_audio_duration - end, desired_pad)
            else:
                gap = chunks[i+1]['start'] - end
                back_pad = min(desired_pad, gap / 2.0)
                
            padded_chunks.append({
                'start': start - front_pad, 
                'end': end + back_pad
            })
            
        return padded_chunks

    def _macro_route_end_cursor(self, norm_asr, norm_ref, current_norm_cursor):
        if not norm_asr:
            return current_norm_cursor

        asr_len = len(norm_asr)
        lookahead_size = max(300, asr_len * 3) 
        search_window = norm_ref[current_norm_cursor : current_norm_cursor + lookahead_size]

        if not search_window:
            print(f"[WARNING] 原文已耗尽，但音频仍有多余识别: '{norm_asr}'。将安全忽略此段音频。")
            return current_norm_cursor

        highest_ratio = 0.0
        best_match_text = ""
        best_match_start = 0
        
        window_size = int(asr_len * 1.2)
        
        for i in range(0, max(1, len(search_window) - window_size // 2)):
            sub_text = search_window[i : i + window_size]
            ratio = Levenshtein.ratio(norm_asr, sub_text)
            
            if ratio > highest_ratio:
                highest_ratio = ratio
                best_match_text = sub_text
                best_match_start = i

        MATCH_THRESHOLD = 0.30
        if highest_ratio < MATCH_THRESHOLD:
            raise RuntimeError(
                f"[FATAL ERROR] 识别结果严重偏离原文或匹配脱轨！\n"
                f"相似度: {highest_ratio:.2f} (低于安全阈值 {MATCH_THRESHOLD})"
            )

        opcodes = Levenshtein.opcodes(norm_asr, best_match_text)
        exact_match_len = len(best_match_text)
        
        for tag, i1, i2, j1, j2 in reversed(opcodes):
            if tag == 'insert':
                exact_match_len = j1
            else:
                break

        best_match_end_idx = best_match_start + exact_match_len
        return current_norm_cursor + best_match_end_idx

    def _generate_diff_report(self, clean_reference, final_result):
        norm_ref = self._normalize_text(clean_reference)
        norm_result = self._normalize_text(final_result)
        
        opcodes = Levenshtein.opcodes(norm_ref, norm_result)
        
        missing_blocks = []
        extra_blocks = []
        
        for tag, i1, i2, j1, j2 in opcodes:
            if tag in ('delete', 'replace'):
                missing_blocks.append(norm_ref[i1:i2])
            if tag in ('insert', 'replace'):
                extra_blocks.append(norm_result[j1:j2])
                
        ratio = Levenshtein.ratio(norm_ref, norm_result)
                
        return {
            "accuracy_ratio": f"{ratio * 100:.2f}%",
            "ref_length": len(norm_ref),
            "result_length": len(norm_result),
            "missing_from_result": missing_blocks,  
            "extra_in_result": extra_blocks         
        }

    def process_audio(self, audio_path, reference_text, language_code=None):
        pipeline_start_time = time.time()
        run_lang = language_code if language_code else self.config["language"]
        
        clean_reference_text = re.sub(r'\s+', ' ', reference_text).strip()
        norm_ref, ref_idx_map = self._build_index_map(clean_reference_text)
        
        print(f"[*] 正在读取音频文件 (对齐模式)...")
        audio_data, sample_rate = sf.read(audio_path)
        wav = torch.from_numpy(audio_data).float()
        
        if wav.dim() > 1:
            wav = wav.mean(dim=1)
            
        if sample_rate != 16000:
            import torchaudio.functional as F
            wav = F.resample(wav, sample_rate, 16000)
            sample_rate = 16000

        total_audio_duration = len(wav) / sample_rate

        print("[*] 正在进行 VAD 物理切片...")
        raw_speech_timestamps = self.get_speech_timestamps(wav, self.vad_model, return_seconds=True)
        
        if not raw_speech_timestamps:
            raise ValueError("VAD 未检测到任何有效人声，音频可能为空白或仅有底噪，停止处理。")

        physical_chunks = self._group_vad_timestamps(raw_speech_timestamps, total_audio_duration)
        total_chunks = len(physical_chunks)
        print(f"[*] 音频已根据 VAD 贪婪切分为 {total_chunks} 个带有静音缓冲的物理长片段。")

        verbose_json = {
            "task": "transcribe",
            "language": run_lang,
            "duration": round(total_audio_duration, 2),
            "report": {}, 
            "text": "", 
            "words": []
        }
        
        current_norm_cursor = 0 
        prev_orig_end = 0 
        
        for idx, chunk_info in enumerate(physical_chunks):
            chunk_start = chunk_info['start']
            chunk_end = chunk_info['end']
            chunk_duration = chunk_end - chunk_start
            
            print(f"\n--- 开始处理第 {idx+1}/{total_chunks} 块 (时长: {chunk_duration:.2f}s) ---")
            
            start_sample = max(0, int(chunk_start * sample_rate))
            end_sample = min(len(wav), int(chunk_end * sample_rate))
            chunk_wav = wav[start_sample:end_sample]
            
            with tempfile.NamedTemporaryFile(suffix=".wav", delete=False) as tmp:
                tmp_path = tmp.name
                sf.write(tmp_path, chunk_wav.numpy(), sample_rate)
            
            try:
                print(f"  [{idx+1}/{total_chunks}] 运行 ASR 宏观识别...")
                asr_start = time.time()
                asr_results = self.asr_model.transcribe(audio=tmp_path, language=run_lang)
                asr_text = asr_results[0].text
                print(f"  [{idx+1}/{total_chunks}] ASR 耗时: {time.time() - asr_start:.2f}s | 寻路匹配原文中...")
                
                norm_asr = self._normalize_text(asr_text)
                if not norm_asr:
                    continue
                    
                abs_end = self._macro_route_end_cursor(norm_asr, norm_ref, current_norm_cursor)
                orig_start = prev_orig_end
                
                if abs_end < len(norm_ref):
                    orig_end = ref_idx_map[abs_end]
                else:
                    orig_end = len(clean_reference_text)
                    
                ground_truth = clean_reference_text[orig_start : orig_end]
                
                current_norm_cursor = abs_end
                prev_orig_end = orig_end
                
                if not ground_truth.strip():
                    continue

                print(f"  [{idx+1}/{total_chunks}] 运行 FA 微观对齐 (目标文本 {len(ground_truth)} 字)...")
                fa_start = time.time()
                fa_results = self.fa_model.align(audio=tmp_path, text=ground_truth, language=run_lang)
                print(f"  [{idx+1}/{total_chunks}] FA 耗时: {time.time() - fa_start:.2f}s")
                
                for word_align in fa_results[0]:
                    w = {
                        "word": word_align.text,
                        "start": round(chunk_start + word_align.start_time, 3),
                        "end": round(chunk_start + word_align.end_time, 3)
                    }
                    verbose_json["words"].append(w)
                    verbose_json["text"] += word_align.text
                    
            finally:
                if os.path.exists(tmp_path):
                    os.remove(tmp_path)

        verbose_json["report"] = self._generate_diff_report(clean_reference_text, verbose_json["text"])
        pipeline_end_time = time.time()
        print(f"\n[*] FA 模式流水线处理完毕！总耗时: {pipeline_end_time - pipeline_start_time:.2f} 秒")
        return verbose_json

    def process_audio_asr_only(self, audio_path, language_code=None):
        pipeline_start_time = time.time()
        run_lang = language_code if language_code else self.config["language"]
        
        print(f"[*] 正在读取音频文件 (纯ASR模式)...")
        audio_data, sample_rate = sf.read(audio_path)
        wav = torch.from_numpy(audio_data).float()
        
        if wav.dim() > 1:
            wav = wav.mean(dim=1)
            
        if sample_rate != 16000:
            import torchaudio.functional as F
            wav = F.resample(wav, sample_rate, 16000)
            sample_rate = 16000

        total_audio_duration = len(wav) / sample_rate

        print("[*] 正在进行 VAD 物理切片...")
        raw_speech_timestamps = self.get_speech_timestamps(wav, self.vad_model, return_seconds=True)
        
        if not raw_speech_timestamps:
            raise ValueError("VAD 未检测到任何有效人声，音频可能为空白或仅有底噪，停止处理。")

        physical_chunks = self._group_vad_timestamps(raw_speech_timestamps, total_audio_duration)
        total_chunks = len(physical_chunks)
        print(f"[*] 音频已根据 VAD 贪婪切分为 {total_chunks} 个带有静音缓冲的物理长片段。")

        verbose_json = {
            "task": "transcribe",
            "language": run_lang,
            "duration": round(total_audio_duration, 2),
            "text": "", 
            "segments": []
        }
        
        for idx, chunk_info in enumerate(physical_chunks):
            chunk_start = chunk_info['start']
            chunk_end = chunk_info['end']
            chunk_duration = chunk_end - chunk_start
            
            print(f"\n--- 开始处理第 {idx+1}/{total_chunks} 块 (时长: {chunk_duration:.2f}s) ---")
            
            start_sample = max(0, int(chunk_start * sample_rate))
            end_sample = min(len(wav), int(chunk_end * sample_rate))
            chunk_wav = wav[start_sample:end_sample]
            
            with tempfile.NamedTemporaryFile(suffix=".wav", delete=False) as tmp:
                tmp_path = tmp.name
                sf.write(tmp_path, chunk_wav.numpy(), sample_rate)
            
            try:
                asr_start = time.time()
                asr_results = self.asr_model.transcribe(audio=tmp_path, language=run_lang)
                asr_text = asr_results[0].text
                print(f"  [{idx+1}/{total_chunks}] ASR 耗时: {time.time() - asr_start:.2f}s")
                
                if asr_text:
                    verbose_json["text"] += asr_text
                    verbose_json["segments"].append({
                        "id": idx,
                        "start": round(chunk_start, 3),
                        "end": round(chunk_end, 3),
                        "text": asr_text
                    })
            finally:
                if os.path.exists(tmp_path):
                    os.remove(tmp_path)

        pipeline_end_time = time.time()
        print(f"\n[*] ASR 模式流水线处理完毕！总耗时: {pipeline_end_time - pipeline_start_time:.2f} 秒")
        return verbose_json


# ==========================================
# 2. 全局状态与探针配置 (新增 STW 控制器)
# ==========================================
CONFIG = {
    "device": "cpu",            
    "cpu_ratio": 0.8,             
    "chunk_max_sec": 60*4,      
    "vad_padding_sec": 0.3,     
    "language": "zh",
}

pipeline_instance = None
gpu_semaphore = None

# --- STW (Stop The World) 状态控制器 ---
world_frozen_event = asyncio.Event()
world_frozen_event.set() # 默认放行状态

active_gpu_requests = 0
gpu_state_lock = asyncio.Lock()
stw_lock = asyncio.Lock()

async def trigger_frozen_world():
    """触发 STW，执行物理清场"""
    global active_gpu_requests
    
    if stw_lock.locked():
        # 如果已经有其他并发请求触发了清场，直接跳过
        return
        
    async with stw_lock:
        # 1. 关门：阻止所有新请求获取 GPU 锁（使其在 wait() 处挂起排队）
        world_frozen_event.clear()
        print("\n[FATAL] 🛑 检测到碎片化 OOM，触发 Frozen World! 暂停进入计算区，后续请求进入排队队列...")
        
        # 2. 等待已经在处理中的其余任务安全退出
        while active_gpu_requests > 0:
            await asyncio.sleep(0.5)
            
        print("[FATAL] 🧹 核心计算区已清零，开始执行物理级显存清理...")
        
        # 3. 强制清零（回收显存及幽灵对象）
        gc.collect()
        if torch.cuda.is_available():
            torch.cuda.empty_cache()
            
        print("[FATAL] ✅ 清理完毕，解除 Frozen World，恢复队列处理。\n")
        
        # 4. 开门：唤醒所有正在排队的请求继续执行
        world_frozen_event.set()

@asynccontextmanager
async def lifespan(app: FastAPI):
    global pipeline_instance, gpu_semaphore
    
    print("\n🚀 开始 Server 生命周期初始化...")
    pipeline_instance = LongAudioAlignPipeline(CONFIG)
    
    if pipeline_instance.device == "cpu" or not torch.cuda.is_available():
        cores = get_container_cpu_count()
        max_concurrency_by_cpu = max(1, cores // 2)
        
        available_ram_gb = get_container_available_memory() / (1024 ** 3)
        
        estimated_ram_per_req_gb = 1.5 
        max_concurrency_by_ram = max(1, int(available_ram_gb // estimated_ram_per_req_gb))
        
        final_concurrency = min(max_concurrency_by_cpu, max_concurrency_by_ram)
        gpu_semaphore = asyncio.Semaphore(final_concurrency)
        
        print(f"[*] 运行在 CPU 模式")
        print(f"  -> 系统总核心数: {cores}，物理内存可用: {available_ram_gb:.2f} GB")
        print(f"  -> 算力限制并发: {max_concurrency_by_cpu} | 内存限制并发: {max_concurrency_by_ram}")
        print(f"✅ 综合短板效应，已自动设置安全并发数为: {final_concurrency}\n")
    else:
        print("\n🤖 正在执行 GPU 动态显存探针测试 (Warm-up)...")
        torch.cuda.reset_peak_memory_stats()
        static_vram = torch.cuda.memory_allocated()
        print(f"  -> 模型静态显存底座占用: {static_vram / (1024**3):.2f} GB")
        
        dummy_audio_path = "temp_dummy_warmup.wav"
        sf.write(dummy_audio_path, np.random.randn(16000 * 5).astype(np.float32) * 0.01, 16000)
        
        try:
            pipeline_instance.asr_model.transcribe(audio=dummy_audio_path, language="zh")
        except Exception:
            pass
            
        try:
            pipeline_instance.fa_model.align(audio=dummy_audio_path, text="假", language="zh")
        except Exception:
            pass 
            
        peak_vram = torch.cuda.max_memory_allocated()
        dynamic_vram_per_req = peak_vram - static_vram
        
        estimated_dynamic_vram = max(dynamic_vram_per_req, 1.5 * 1024**3) 
        print(f"  -> 预估单次请求动态显存峰值: {estimated_dynamic_vram / (1024**3):.2f} GB")
        
        total_vram = torch.cuda.get_device_properties(0).total_memory
        safe_buffer = 1 * 1024**3 
        available_vram = total_vram - static_vram - safe_buffer
        
        max_concurrency = max(1, int(available_vram // estimated_dynamic_vram))
        print(f"✅ 探针计算完毕！当前硬件 ({torch.cuda.get_device_name(0)}) 最佳安全并发数为: {max_concurrency}\n")
        
        gpu_semaphore = asyncio.Semaphore(max_concurrency)
        
        if os.path.exists(dummy_audio_path):
            os.remove(dummy_audio_path)

    yield 
    print("🛑 Server 正在关闭，清理资源...")


# ==========================================
# 3. FastAPI 主网关与排队路由
# ==========================================
app = FastAPI(lifespan=lifespan, title="Long Audio Aligner API")

@app.post("/v1/audio/transcriptions")
async def openai_asr_endpoint(
    file: UploadFile = File(..., description="要处理的音频文件"),
    model: str = Form(..., description="强制要求：必须指定为 Qwen/Qwen3-ForcedAligner-0.6B 或 Qwen/Qwen3-ASR-0.6B"),
    prompt: str = Form(default="", description="对齐模式(FA)必填，纯ASR模式选填/忽略"),
    response_format: str = Form(default="json", description="支持 json 或 verbose_json"),
    language: str = Form(default=None, description="语言")
):
    global active_gpu_requests
    
    valid_models = ["Qwen/Qwen3-ForcedAligner-0.6B", "Qwen/Qwen3-ASR-0.6B"]
    if model not in valid_models:
        raise HTTPException(
            status_code=400, 
            detail={"error": {"message": f"Bad Request: Unsupported model '{model}'. Valid models are {valid_models}.", "type": "invalid_request_error"}}
        )

    is_alignment_mode = (model == "Qwen/Qwen3-ForcedAligner-0.6B")

    if is_alignment_mode:
        if not prompt or not prompt.strip():
            raise HTTPException(
                status_code=400, 
                detail={"error": {"message": "Bad Request: The 'prompt' parameter is strictly required for ForcedAligner mode.", "type": "invalid_request_error"}}
            )
        if response_format != "verbose_json":
            raise HTTPException(
                status_code=400, 
                detail={"error": {"message": "Bad Request: Only 'verbose_json' response_format is supported in ForcedAligner mode.", "type": "invalid_request_error"}}
            )

    suffix = os.path.splitext(file.filename)[1] if file.filename else ".wav"
    with tempfile.NamedTemporaryFile(delete=False, suffix=suffix) as tmp:
        content = await file.read()
        tmp.write(content)
        tmp_path = tmp.name

    try:
        max_retries = 3
        
        for attempt in range(max_retries):
            # [STW 屏障]：如果世界被冻结，新来的和重试的请求都在这里安静排队
            await world_frozen_event.wait()
            
            try:
                async with gpu_semaphore:
                    # 登记进入计算区
                    async with gpu_state_lock:
                        active_gpu_requests += 1
                        
                    try:
                        if is_alignment_mode:
                            result = await run_in_threadpool(
                                pipeline_instance.process_audio, 
                                audio_path=tmp_path, 
                                reference_text=prompt,
                                language_code=language
                            )
                        else:
                            result = await run_in_threadpool(
                                pipeline_instance.process_audio_asr_only, 
                                audio_path=tmp_path,
                                language_code=language
                            )
                            
                        # 执行成功，跳出重试循环
                        if not is_alignment_mode and response_format == "json":
                            return {"text": result.get("text", "")}
                        return result
                        
                    finally:
                        # 离开计算区
                        async with gpu_state_lock:
                            active_gpu_requests -= 1
                            
            except Exception as e:
                # 判断是否为 OOM 错误 (支持跨版本 PyTorch 判断)
                is_oom = False
                try:
                    if isinstance(e, torch.cuda.OutOfMemoryError):
                        is_oom = True
                except AttributeError:
                    pass
                if "out of memory" in str(e).lower():
                    is_oom = True

                if is_oom:
                    if attempt == max_retries - 1:
                        # 如果穷尽重试仍旧 OOM，抛出异常。
                        raise HTTPException(status_code=500, detail={"error": {"message": "GPU 资源耗尽，请求经历排队重试后依然失败。", "type": "server_error"}})
                    
                    print(f"  -> [拦截] OOM 发生！当前请求转入挂起重试状态 ({attempt+1}/{max_retries})...")
                    # 触发 STW
                    asyncio.create_task(trigger_frozen_world())
                    # 强迫当前任务交出协程控制权，确保大门能关上
                    await asyncio.sleep(1) 
                else:
                    # 非内存类错误，属于正常业务失败，直接抛出
                    if isinstance(e, ValueError):
                        raise HTTPException(status_code=400, detail={"error": {"message": str(e), "type": "invalid_request_error"}})
                    raise HTTPException(status_code=500, detail={"error": {"message": str(e), "type": "server_error"}})
                    
    finally:
        # 文件必须在所有的排队与执行彻底结束后才能删
        if os.path.exists(tmp_path):
            os.remove(tmp_path)


# ==========================================
# 4. Gradio 可视化 UI 挂载 (同步加入排队保护)
# ==========================================
async def gradio_bridge(audio_filepath, ref_text, selected_model):
    global active_gpu_requests
    
    if not audio_filepath:
        return "❌ 错误: 请先上传音频。"
    
    is_alignment = (selected_model == "Qwen/Qwen3-ForcedAligner-0.6B")
    
    if is_alignment and (not ref_text or not ref_text.strip()):
        return "❌ 错误: ForcedAligner 对齐模式下，必须提供参考原文 (prompt)。"
    
    max_retries = 3
    for attempt in range(max_retries):
        await world_frozen_event.wait()
        try:
            async with gpu_semaphore:
                async with gpu_state_lock:
                    active_gpu_requests += 1
                try:
                    if is_alignment:
                        result = await run_in_threadpool(
                            pipeline_instance.process_audio, 
                            audio_path=audio_filepath, 
                            reference_text=ref_text,
                            language_code="zh" 
                        )
                    else:
                        result = await run_in_threadpool(
                            pipeline_instance.process_audio_asr_only, 
                            audio_path=audio_filepath, 
                            language_code="zh" 
                        )
                    return json.dumps(result, ensure_ascii=False, indent=2)
                finally:
                    async with gpu_state_lock:
                        active_gpu_requests -= 1
        except Exception as e:
            is_oom = False
            try:
                if isinstance(e, torch.cuda.OutOfMemoryError):
                    is_oom = True
            except AttributeError:
                pass
            if "out of memory" in str(e).lower():
                is_oom = True

            if is_oom:
                if attempt == max_retries - 1:
                    return "🚨 发生错误: GPU OOM，多次重试失败。"
                asyncio.create_task(trigger_frozen_world())
                await asyncio.sleep(1)
            else:
                return f"🚨 发生错误: {str(e)}"

with gr.Blocks(title="Audio Processing UI") as demo:
    gr.Markdown("## 🎙️ Audio Processing Server (支持 ASR 与 强制对齐)")
    gr.Markdown(f"✅ **API 地址**: `http://<YOUR_IP>:<PORT>/v1/audio/transcriptions`  \n✅ **并发锁保护**: 已开启 | **防碎片 STW 队列**: 已开启")
    
    with gr.Row():
        with gr.Column(scale=1):
            ui_model = gr.Dropdown(
                choices=["Qwen/Qwen3-ForcedAligner-0.6B", "Qwen/Qwen3-ASR-0.6B"], 
                value="Qwen/Qwen3-ForcedAligner-0.6B", 
                label="0. 选择处理模式 (Model)"
            )
            ui_audio = gr.Audio(type="filepath", label="1. 上传测试音频")
            ui_text = gr.Textbox(lines=5, label="2. 参考原文 (纯 ASR 模式下此项会被忽略)", placeholder="对齐模式请在此粘贴带标点的完整参考文本...")
            ui_btn = gr.Button("开始处理", variant="primary")
        with gr.Column(scale=1):
            ui_output = gr.JSON(label="响应结果")

    ui_btn.click(fn=gradio_bridge, inputs=[ui_audio, ui_text, ui_model], outputs=ui_output)

app = gr.mount_gradio_app(app, demo, path="/ui")


# ==========================================
# 程序启动入口
# ==========================================
if __name__ == "__main__":
    host = os.environ.get("HOST", "0.0.0.0")
    port = int(os.environ.get("PORT", 8100))
    
    print("="*50)
    print(f"🌐 Server 将在 http://{host}:{port} 启动")
    print(f"👉 API 接口端点: http://{host}:{port}/v1/audio/transcriptions")
    print(f"👉 调试 UI 界面: http://{host}:{port}/ui")
    print("="*50)
    
    uvicorn.run(app, host=host, port=port, log_level="warning")